<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Reading vendor VHAL properties (the 12 V system voltage, VPOWERINFO_BATTERY_VOL) through
         Android's car service. Unknown permissions are simply not granted elsewhere, so it is
         harmless on devices without a car service. No <uses-library android:name="android.car">:
         the car-lib classes this flavor needs are either on the vendor boot class path or bundled
         in the AdaptAPI jar. -->
    <uses-permission android:name="android.car.permission.CAR_VENDOR_EXTENSION" />
</manifest>
