<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/brickMediaBlock"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- ============================ ОБЩИЕ ============================ -->
    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/brickMediaShowSource"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/optionsMarginSmall"
        android:minHeight="@dimen/optionsLineHeight"
        android:text="@string/brick_media_show_source"
        android:textAppearance="?attr/textAppearanceBodyLarge" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/brickMediaTitleFirst"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/optionsMarginSmall"
        android:minHeight="@dimen/optionsLineHeight"
        android:text="@string/brick_media_title_first"
        android:textAppearance="?attr/textAppearanceBodyLarge" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/brickMediaProgressBarEnabled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/optionsMarginSmall"
        android:minHeight="@dimen/optionsLineHeight"
        android:text="@string/brick_media_progress_bar_enabled"
        android:textAppearance="?attr/textAppearanceBodyLarge" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/brickMediaShowPlaybackState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/optionsMarginSmall"
        android:minHeight="@dimen/optionsLineHeight"
        android:text="@string/brick_media_show_playback_state"
        android:textAppearance="?attr/textAppearanceBodyLarge" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/optionsMarginSmall"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/brick_media_max_width"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <TextView
                    android:id="@+id/brickMediaMaxWidthSliderValue"
                    style="@style/SliderValue" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/brickMediaMaxWidthSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/brick_media_max_width"
                android:value="500"
                android:valueFrom="100"
                android:valueTo="1000" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/optionsMarginSmall"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/brick_media_line_gap"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <TextView
                    android:id="@+id/brickMediaLineGapSliderValue"
                    style="@style/SliderValue" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/brickMediaLineGapSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/brick_media_line_gap"
                android:value="0"
                android:valueFrom="0"
                android:valueTo="100" />
        </LinearLayout>
    </LinearLayout>

    <!-- ============================ ИСТОЧНИК ============================ -->
    <LinearLayout
        android:id="@+id/brickMediaSourceSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/optionsMargin"
            android:text="@string/brick_media_source_section"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <!-- font size + content alpha — paired row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/optionsMarginSmall"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/brick_font_size"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />

                    <TextView
                        android:id="@+id/brickMediaSourceFontSizeSliderValue"
                        style="@style/SliderValue" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/brickMediaSourceFontSizeSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/brick_font_size"
                    android:value="20"
                    android:valueFrom="10"
                    android:valueTo="500" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/optionsMarginSmall"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/brick_content_alpha"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />

                    <TextView
                        android:id="@+id/brickMediaSourceContentAlphaSliderValue"
                        style="@style/SliderValue" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/brickMediaSourceContentAlphaSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/brick_content_alpha"
                    android:value="255"
                    android:valueFrom="0"
                    android:valueTo="255" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/optionsMarginSmall"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/brick_outline_alpha"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />

                    <TextView
                        android:id="@+id/brickMediaSourceOutlineAlphaSliderValue"
                        style="@style/SliderValue" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/brickMediaSourceOutlineAlphaSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/brick_outline_alpha"
                    android:value="170"
                    android:valueFrom="0"
                    android:valueTo="255" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/optionsMarginSmall"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/brick_outline_width"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />

                    <TextView
                        android:id="@+id/brickMediaSourceOutlineWidthSliderValue"
                        style="@style/SliderValue" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/brickMediaSourceOutlineWidthSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/brick_outline_width"
                    android:value="2"
                    android:valueFrom="0"
                    android:valueTo="20" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/optionsMarginSmall"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/brick_text_alignment">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/brickMediaSourceAlignmentDropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/optionsMarginSmall"
                android:layout_weight="1"
                android:hint="@string/brick_font_family">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/brickMediaSourceFontFamilyDropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/brickMediaSourceFontStyleGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/optionsMarginSmall"
                app:singleSelection="false">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/brickMediaSourceFontBold"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/brick_font_bold"
                    android:minWidth="0dp"
                    android:paddingHorizontal="@dimen/optionsMargin"
                    android:text="@string/brick_font_bold_short"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/brickMediaSourceFontItalic"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/brick_font_italic"
                    android:minWidth="0dp"
                    android:paddingHorizontal="@dimen/optionsMargin"
                    android:text="@string/brick_font_italic_short"
                    android:textStyle="italic" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>
    </LinearLayout>

    <!-- ============================ КОМПОЗИЦИЯ ============================ -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/optionsMargin"
        android:text="@string/brick_media_title_section"
        android:textAppearance="?attr/textAppearanceTitleSmall" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/brickMediaMarqueeEnabled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/optionsMarginSmall"
        android:minHeight="@dimen/optionsLineHeight"
        android:text="@string/brick_media_marquee_enabled"
        android:textAppearance="?attr/textAppearanceBodyLarge" />

    <!-- font size + content alpha — paired row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/optionsMarginSmall"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/brick_font_size"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <TextView
                    android:id="@+id/brickMediaTitleFontSizeSliderValue"
                    style="@style/SliderValue" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/brickMediaTitleFontSizeSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/brick_font_size"
                android:value="20"
                android:valueFrom="10"
                android:valueTo="500" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/optionsMarginSmall"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/brick_content_alpha"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <TextView
                    android:id="@+id/brickMediaTitleContentAlphaSliderValue"
                    style="@style/SliderValue" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/brickMediaTitleContentAlphaSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/brick_content_alpha"
                android:value="255"
                android:valueFrom="0"
                android:valueTo="255" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/optionsMarginSmall"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/brick_outline_alpha"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <TextView
                    android:id="@+id/brickMediaTitleOutlineAlphaSliderValue"
                    style="@style/SliderValue" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/brickMediaTitleOutlineAlphaSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/brick_outline_alpha"
                android:value="170"
                android:valueFrom="0"
                android:valueTo="255" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/optionsMarginSmall"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/brick_outline_width"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <TextView
                    android:id="@+id/brickMediaTitleOutlineWidthSliderValue"
                    style="@style/SliderValue" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/brickMediaTitleOutlineWidthSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/brick_outline_width"
                android:value="2"
                android:valueFrom="0"
                android:valueTo="20" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/optionsMarginSmall"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/brick_text_alignment">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/brickMediaTitleAlignmentDropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/optionsMarginSmall"
            android:layout_weight="1"
            android:hint="@string/brick_font_family">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/brickMediaTitleFontFamilyDropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/brickMediaTitleFontStyleGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/optionsMarginSmall"
            app:singleSelection="false">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/brickMediaTitleFontBold"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/brick_font_bold"
                android:minWidth="0dp"
                android:paddingHorizontal="@dimen/optionsMargin"
                android:text="@string/brick_font_bold_short"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/brickMediaTitleFontItalic"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/brick_font_italic"
                android:minWidth="0dp"
                android:paddingHorizontal="@dimen/optionsMargin"
                android:text="@string/brick_font_italic_short"
                android:textStyle="italic" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
    </LinearLayout>

    <!-- ============================ ДЛИТЕЛЬНОСТЬ ============================ -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/optionsMargin"
        android:text="@string/brick_media_duration_section"
        android:textAppearance="?attr/textAppearanceTitleSmall" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/brickMediaShowDuration"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/optionsMarginSmall"
        android:minHeight="@dimen/optionsLineHeight"
        android:text="@string/brick_media_show_duration"
        android:textAppearance="?attr/textAppearanceBodyLarge" />

    <LinearLayout
        android:id="@+id/brickMediaDurationSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- font size + content alpha — paired row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/optionsMarginSmall"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/brick_font_size"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />

                    <TextView
                        android:id="@+id/brickMediaDurationFontSizeSliderValue"
                        style="@style/SliderValue" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/brickMediaDurationFontSizeSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/brick_font_size"
                    android:value="16"
                    android:valueFrom="10"
                    android:valueTo="500" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/optionsMarginSmall"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/brick_content_alpha"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />

                    <TextView
                        android:id="@+id/brickMediaDurationContentAlphaSliderValue"
                        style="@style/SliderValue" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/brickMediaDurationContentAlphaSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/brick_content_alpha"
                    android:value="255"
                    android:valueFrom="0"
                    android:valueTo="255" />
            </LinearLayout>
        </LinearLayout>

        <!-- outline alpha + outline width — paired row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/optionsMarginSmall"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/brick_outline_alpha"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />

                    <TextView
                        android:id="@+id/brickMediaDurationOutlineAlphaSliderValue"
                        style="@style/SliderValue" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/brickMediaDurationOutlineAlphaSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/brick_outline_alpha"
                    android:value="170"
                    android:valueFrom="0"
                    android:valueTo="255" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/optionsMarginSmall"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/brick_outline_width"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />

                    <TextView
                        android:id="@+id/brickMediaDurationOutlineWidthSliderValue"
                        style="@style/SliderValue" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/brickMediaDurationOutlineWidthSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/brick_outline_width"
                    android:value="2"
                    android:valueFrom="0"
                    android:valueTo="20" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/optionsMargin"
        android:text="@string/show_media_hint"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/brickMediaPermissionButton"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/optionsMarginSmall"
        android:text="@string/grant_notification_access" />
</LinearLayout>
