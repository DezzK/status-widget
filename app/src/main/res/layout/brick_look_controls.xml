<!--
  ~ One element's look: size + vertical offset, outline, opacity, margins. Included twice in a
  ~ brick card — once for the brick itself and once for a reading brick's icon — and bound by
  ~ LookControls, which finds these views inside its own include, never through the card. The ids
  ~ therefore repeat inside one card on purpose; ViewBinder.findValueLabel still pairs each slider
  ~ with the value label of its own column, the nearest match on its way up.
  -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/lookSizeAdjustRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!--
          ~ The two columns are independently hideable (BrickControl.COL_SIZE /
          ~ COL_ADJUST_Y): the media brick wants the vertical offset but carries three
          ~ font-size sliders of its own. The inter-column gutter lives on the size
          ~ column — the only one any brick drops today — so it disappears with it and
          ~ the survivor's layout_weight=1 stretches to the full row with no stray
          ~ indent. A future brick that hides adjustY instead would need the gutter
          ~ moved to a <Space> between the columns.
          -->
        <LinearLayout
            android:id="@+id/lookSizeColumn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/optionsMarginSmall"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/lookSizeLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/brick_font_size"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <TextView
                    android:id="@+id/lookSizeSliderValue"
                    style="@style/SliderValue" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/lookSizeSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/brick_font_size"
                android:value="20"
                android:valueFrom="10"
                android:valueTo="500" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/lookAdjustYColumn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/brick_adjust_y"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <TextView
                    android:id="@+id/lookAdjustYSliderValue"
                    style="@style/SliderValue" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/lookAdjustYSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/brick_adjust_y"
                android:value="0"
                android:valueFrom="-100"
                android:valueTo="100" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/lookOutlineRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/optionsMarginSmall"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/brick_outline_alpha"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <TextView
                    android:id="@+id/lookOutlineAlphaSliderValue"
                    style="@style/SliderValue" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/lookOutlineAlphaSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/brick_outline_alpha"
                android:value="170"
                android:valueFrom="0"
                android:valueTo="255" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/optionsMarginSmall"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/brick_outline_width"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <TextView
                    android:id="@+id/lookOutlineWidthSliderValue"
                    style="@style/SliderValue" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/lookOutlineWidthSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/brick_outline_width"
                android:value="2"
                android:valueFrom="0"
                android:valueTo="20" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/lookContentAlphaRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/optionsMarginSmall"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/brick_content_alpha"
                android:textAppearance="?attr/textAppearanceBodyMedium" />

            <TextView
                android:id="@+id/lookContentAlphaSliderValue"
                style="@style/SliderValue" />
        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/lookContentAlphaSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/brick_content_alpha"
            android:value="255"
            android:valueFrom="0"
            android:valueTo="255" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/lookMarginRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/optionsMarginSmall"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/brick_margin_start"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <TextView
                    android:id="@+id/lookMarginStartSliderValue"
                    style="@style/SliderValue" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/lookMarginStartSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/brick_margin_start"
                android:value="0"
                android:valueFrom="0"
                android:valueTo="300" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/optionsMarginSmall"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/brick_margin_end"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <TextView
                    android:id="@+id/lookMarginEndSliderValue"
                    style="@style/SliderValue" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/lookMarginEndSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/brick_margin_end"
                android:value="0"
                android:valueFrom="0"
                android:valueTo="300" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
