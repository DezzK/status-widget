<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/brickCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="@dimen/optionsMarginSmall"
    app:cardElevation="0dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/optionsMarginSmall">

        <LinearLayout
            android:id="@+id/brickHeader"
            android:layout_width="match_parent"
            android:layout_height="?attr/listPreferredItemHeightSmall"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/brickDragHandle"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="@string/brick_drag_handle"
                android:src="@drawable/ic_drag_handle" />

            <TextView
                android:id="@+id/brickTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/optionsMarginSmall"
                android:layout_weight="1"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                tools:text="Time" />

            <ImageView
                android:id="@+id/brickExpand"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="@string/brick_expand"
                android:src="@drawable/ic_expand_more" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/brickPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/optionsMarginSmall"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:id="@+id/brickSizeAdjustRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!--
                  ~ The two columns are independently hideable (BrickControl.COL_SIZE /
                  ~ COL_ADJUST_Y): the media brick wants the vertical offset but carries three
                  ~ font-size sliders of its own. The inter-column gutter lives on the size
                  ~ column — the only one any brick drops today — so it disappears with it and
                  ~ the survivor's layout_weight=1 stretches to the full row with no stray
                  ~ indent. A future brick that hides adjustY instead would need the gutter
                  ~ moved to a <Space> between the columns.
                  -->
                <LinearLayout
                    android:id="@+id/brickSizeColumn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/optionsMarginSmall"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/brickSizeLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/brick_font_size"
                            android:textAppearance="?attr/textAppearanceBodyMedium" />

                        <TextView
                            android:id="@+id/brickSizeSliderValue"
                            style="@style/SliderValue" />
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/brickSizeSlider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/brick_font_size"
                        android:value="20"
                        android:valueFrom="10"
                        android:valueTo="500" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/brickAdjustYColumn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/brick_adjust_y"
                            android:textAppearance="?attr/textAppearanceBodyMedium" />

                        <TextView
                            android:id="@+id/brickAdjustYSliderValue"
                            style="@style/SliderValue" />
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/brickAdjustYSlider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/brick_adjust_y"
                        android:value="0"
                        android:valueFrom="-100"
                        android:valueTo="100" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/brickOutlineRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/optionsMarginSmall"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/brick_outline_alpha"
                            android:textAppearance="?attr/textAppearanceBodyMedium" />

                        <TextView
                            android:id="@+id/brickOutlineAlphaSliderValue"
                            style="@style/SliderValue" />
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/brickOutlineAlphaSlider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/brick_outline_alpha"
                        android:value="170"
                        android:valueFrom="0"
                        android:valueTo="255" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/optionsMarginSmall"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/brick_outline_width"
                            android:textAppearance="?attr/textAppearanceBodyMedium" />

                        <TextView
                            android:id="@+id/brickOutlineWidthSliderValue"
                            style="@style/SliderValue" />
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/brickOutlineWidthSlider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/brick_outline_width"
                        android:value="2"
                        android:valueFrom="0"
                        android:valueTo="20" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/brickTableRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/optionsMarginSmall"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/brick_table_rows"
                            android:textAppearance="?attr/textAppearanceBodyMedium" />

                        <TextView
                            android:id="@+id/brickTableRowsSliderValue"
                            style="@style/SliderValue" />
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/brickTableRowsSlider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/brick_table_rows"
                        android:stepSize="1"
                        android:value="1"
                        android:valueFrom="1"
                        android:valueTo="4" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/optionsMarginSmall"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/brick_table_cell_gap"
                            android:textAppearance="?attr/textAppearanceBodyMedium" />

                        <TextView
                            android:id="@+id/brickTableCellGapSliderValue"
                            style="@style/SliderValue" />
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/brickTableCellGapSlider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/brick_table_cell_gap"
                        android:value="12"
                        android:valueFrom="0"
                        android:valueTo="200" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/brickContentAlphaRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/optionsMarginSmall"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/brick_content_alpha"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />

                    <TextView
                        android:id="@+id/brickContentAlphaSliderValue"
                        style="@style/SliderValue" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/brickContentAlphaSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/brick_content_alpha"
                    android:value="255"
                    android:valueFrom="0"
                    android:valueTo="255" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/brickMarginRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/optionsMarginSmall"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/brick_margin_start"
                            android:textAppearance="?attr/textAppearanceBodyMedium" />

                        <TextView
                            android:id="@+id/brickMarginStartSliderValue"
                            style="@style/SliderValue" />
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/brickMarginStartSlider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/brick_margin_start"
                        android:value="0"
                        android:valueFrom="0"
                        android:valueTo="300" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/optionsMarginSmall"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/brick_margin_end"
                            android:textAppearance="?attr/textAppearanceBodyMedium" />

                        <TextView
                            android:id="@+id/brickMarginEndSliderValue"
                            style="@style/SliderValue" />
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/brickMarginEndSlider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/brick_margin_end"
                        android:value="0"
                        android:valueFrom="0"
                        android:valueTo="300" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/brickFontBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/optionsMargin"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/brick_font_family">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/brickFontFamilyDropdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/brickFontStyleGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/optionsMarginSmall"
                    app:singleSelection="false">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/brickFontBold"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/brick_font_bold"
                        android:minWidth="0dp"
                        android:paddingHorizontal="@dimen/optionsMargin"
                        android:text="@string/brick_font_bold_short"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/brickFontItalic"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/brick_font_italic"
                        android:minWidth="0dp"
                        android:paddingHorizontal="@dimen/optionsMargin"
                        android:text="@string/brick_font_italic_short"
                        android:textStyle="italic" />
                </com.google.android.material.button.MaterialButtonToggleGroup>
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/brickStatusAlignmentLayout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/optionsMargin"
                android:hint="@string/brick_status_alignment"
                android:visibility="gone">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/brickStatusAlignmentDropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <FrameLayout
                android:id="@+id/brickTypeBlockSlot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:id="@+id/brickHideOwnBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/optionsMargin"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/brickHideInAppsButton"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/brick_hide_in_apps" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/brickHideKeepsSpaceOwnSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/optionsMarginSmall"
                        android:text="@string/brick_hide_keeps_space" />
                </LinearLayout>

                <TextView
                    android:id="@+id/brickHideApplyToLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/optionsMarginSmall"
                    android:text="@string/brick_hide_apply_to"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/brickHideApplyToChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/brickHideInheritedBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/brickHideInheritedHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/optionsMargin"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/optionsMarginSmall"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/brickHideUseOwnButton"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/brick_hide_use_own_list" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/brickHideKeepsSpaceInheritedSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/optionsMarginSmall"
                        android:text="@string/brick_hide_keeps_space" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/optionsMargin"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/brickResetButton"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/brick_reset_button" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/brickRemoveButton"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/optionsMarginSmall"
                    android:layout_weight="1"
                    android:text="@string/remove_element" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
